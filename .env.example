# --- Lead sourcing (Apollo.io) ---
# Without this the app serves realistic mock leads so the UI is fully usable.
APOLLO_API_KEY=

# --- Email sending ---
# Sender precedence: Gmail/SMTP (if SMTP_USER+SMTP_PASS set) -> Resend (if RESEND_API_KEY) -> simulated.
EMAIL_FROM="Brand Vibe <brandvibe2k26@gmail.com>"

# Option A: Gmail / SMTP (send FROM a Gmail address using a Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=brandvibe2k26@gmail.com
SMTP_PASS=            # 16-char Google App Password (needs 2-Step Verification ON)

# Option B: Resend (send from a verified domain)
RESEND_API_KEY=

# --- Storage (Neon Postgres) ---
# Without this the app uses an in-memory store seeded with sample data (great for local/demo,
# but data resets on serverless cold starts in production — set this for real persistence).
DATABASE_URL=

# --- App URL (used to build tracking pixel + click links) ---
# Set to your deployed origin, e.g. https://gtm-flow.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Resend webhook signing secret (optional, for delivered/bounced events) ---
RESEND_WEBHOOK_SECRET=
